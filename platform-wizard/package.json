{
  "name": "@kannan19302/platform-wizard",
  "version": "2.0.0",
  "private": true,
  "description": "UniERP Global Platform Wizard — SSO landing page and platform switcher (P0, port 4000). Replaces the vanilla-Node mock: the wizard is a real Next.js relying party on the OIDC provider in idp, not a source of authentication decisions.",
