# Copy to infra/.env and fill in, or run: scripts/gen-dev-secrets.sh
# Compose refuses to start if any of these are unset — that is deliberate.
# There are no default values anywhere in the tree.

NEXTAUTH_SECRET=      # session/JWT signing (32-byte hex)
PII_ENCRYPTION_KEY=   # PII field encryption (32-byte hex)
JWT_SECRET=           # marketing-site admin console (32-byte hex)
ENCRYPTION_KEY=       # marketing-site field encryption (32-byte hex)
SSO_SECRET=           # platform wizard (32-byte hex)
